{
    "name": "soysudhanshu/katana-docs",
    "description": "Documentation for Katana Template Engine",
    "type": "project",
    "license": "MIT",
    "scripts": {
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npm run dev"
        ],
        "build": [
            "rm -rf ./dist",
            "npm run build",
            "php ./cli build:generate-html"
        ],
        "preview": [
            "@build",
            "npm run wrangler dev"
        ]
    },
    "autoload": {
        "psr-4": {
            "App\\": "./src"
        },
        "files": [
            "./src/helpers.php"
        ]
    },
    "authors": [
        {
            "name": "Sudhanshu R."
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "katanaphp/blade": "dev-master",
        "league/commonmark": "^2.8",
        "symfony/console": "^8.1"
    },
    "require-dev": {
        "symfony/var-dumper": "^8.1"
    }
}